{% assign repository_slug = include.repository | replace: '/', '-' | downcase %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="w-100"
      alt="{{ include.repository }} GitHub repository"
      src="{{ '/assets/img/repositories/github-repo-' | append: repository_slug | append: '.svg' | relative_url }}"
    >
  </a>
</div>
