<div class="repo p-2 text-center">
  {% assign username_slug = include.username | downcase %}
  <a href="https://github.com/{{ include.username }}">
    <img
      class="w-100"
      alt="{{ include.username }} GitHub profile"
      src="{{ '/assets/img/repositories/github-user-' | append: username_slug | append: '.svg' | relative_url }}"
    >
  </a>
</div>
